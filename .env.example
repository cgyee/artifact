# Copy to .env and fill in local values. .env is gitignored.

# MongoDB connection string. Local dev typically:
MONGODB_URI=mongodb://localhost:27017

# Origin of the editor app. Baked into the injected preview script's
# postMessage target origin and origin check. Must match where you're
# actually visiting the editor.
CLIENT_URL=http://glitch.local:5173

# When "production", enables prod-specific behavior. Leave unset or empty
# for local dev.
# ENV=production
